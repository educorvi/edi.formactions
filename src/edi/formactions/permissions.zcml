<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:zcml="http://namespaces.zope.org/zcml"
  i18n_domain="plone">

  <configure zcml:condition="installed AccessControl.security">
  <!-- -*- extra stuff goes here -*- -->

    <permission
        id="edi.formactions.AddFileStorageHandler"
        title="edi.formactions: Add FileStorageHandler"
    />


    <permission
        id="edi.formactions.AddStorageHandler"
        title="edi.formactions: Add StorageHandler"
    />


    <permission
        id="edi.formactions.AddEndpoint"
        title="edi.formactions: Add Endpoint"
    />


    <permission
        id="edi.formactions.AddWebserviceHandler"
        title="edi.formactions: Add WebserviceHandler"
    />


    <permission
        id="edi.formactions.AddResetButton"
        title="edi.formactions: Add ResetButton"
    />


    <permission
        id="edi.formactions.AddEmailHandler"
        title="edi.formactions: Add EmailHandler"
    />


    <permission
        id="edi.formactions.AddButtonHandler"
        title="edi.formactions: Add ButtonHandler"
    />

    <permission
        id="edi.formactions.AddJsonFormsDocument"
        title="edi.formactions: Add JsonFormsDocument"
    />

  </configure>

</configure>
