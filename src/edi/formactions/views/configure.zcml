<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="edi.formactions">

 <!-- -*- extra stuff goes here -*- -->

  <browser:page
    name="annotations-view"
    for="edi.jsonforms.content.form.IForm"
    class=".annotations_view.AnnotationsView"
    template="annotations_view.pt"
    permission="zope2.View"
    layer="edi.formactions.interfaces.IEdiFormactionsLayer"
    title="Annotations"
    menu="plone_displayviews"
    i18n:domain="edi.formactions"
    />




</configure>
