<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      i18n:domain="edi.formactions"
      metal:use-macro="context/main_template/macros/master">
<body>

  <metal:block fill-slot="content-core">
    <div class="mb-3">
      <a class="btn btn-primary" href="?download=csv">CSV herunterladen</a>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" tal:repeat="column python: view.COLUMNS" tal:content="python: column[1]"></th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="service python: view.get_services()">
            <th scope="row" tal:content="service/service_id"></th>
            <td tal:content="service/service_title"></td>
            <td tal:content="service/service_description"></td>
            <td tal:define="mandant service/mandant">
              <ul>
                <li tal:repeat="m mandant" tal:content="m"></li>
              </ul>
            </td>
            <td tal:content="service/bearbeitung_durch"></td>
            <td tal:content="service/fachbereich"></td>
            <td tal:content="service/status"></td>
            <td tal:content="service/fachdomaene"></td>
            <td tal:content="service/fachbereich_subdomaene"></td>
            <td tal:define="querschnittsthemen service/querschnittsthemen">
              <ul>
                <li tal:repeat="querschnittsthema querschnittsthemen" tal:content="querschnittsthema"></li>
              </ul>
            </td>
            <td tal:define="potenziale service/list_potenziale">
              <ul>
                <li tal:repeat="potenzial potenziale" tal:content="potenzial"></li>
              </ul>
            </td>
            <td tal:content="service/potenziale_weitere"></td>
            <td tal:content="service/browser"></td>
            <td tal:content="service/app_pwa"></td>
            <td tal:content="service/api"></td>
            <td tal:content="service/chatbot"></td>
            <td tal:content="service/ki_assistenz"></td>
            <td tal:content="service/automatisierung"></td>
            <td tal:content="service/aufwand"></td>
            <td tal:content="service/ideen"></td>
          </tr>
        </tbody>
      </table>
    </div>
    </metal:block>
</body>
</html>
