<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      i18n:domain="edi.formactions"
      metal:use-macro="context/main_template/macros/master">
<body>

  <metal:block fill-slot="content-core">
    <div class="mb-3">
      <a class="btn btn-primary" href="?download=tsv" i18n:translate="">Download TSV</a>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" tal:repeat="column python: view.get_columns()" tal:content="python: column"></th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="row python: view.get_rows()">
            <td tal:repeat="column python: view.columns">
              <span tal:define="cell python: row.get(column, '')" tal:condition="python: not isinstance(cell, list)" tal:content="cell"></span>
              <ul tal:define="cell python: row.get(column, '')" tal:condition="python: isinstance(cell, list)">
                <li tal:repeat="element cell" tal:content="structure python: element"></li>
              </ul>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    </metal:block>
</body>
</html>