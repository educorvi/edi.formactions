<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:browser="http://namespaces.zope.org/browser"
  xmlns:plone="http://namespaces.plone.org/plone"
  xmlns:zcml="http://namespaces.zope.org/zcml"
  i18n_domain="plone">

    <include package="plone.behavior" file="meta.zcml"/>

    <!-- -*- extra stuff goes here -*- -->

    <plone:behavior
        name="edi.formactions.success_page"
        title="Success Page"
        description="Configure the success page for the form."
        provides=".success_page.ISuccessPage"
        factory=".success_page.SuccessPage"
        marker=".success_page.ISuccessPageMarker"
        />


</configure>
